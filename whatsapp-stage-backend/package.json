{
  "name": "whatsapp-stage-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Node.js + TypeScript backend for WhatsApp Cloud API on stage/local",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "smoke": "bash scripts/smoke-tests.sh",
    "test:whatsapp-retry": "ts-node scripts/test-whatsapp-retry.ts",
    "test:reservation-template": "ts-node scripts/test-reservation-template.ts",
    "test:approved-templates": "ts-node scripts/test-approved-templates.ts",
    "test:document-templates": "ts-node scripts/test-document-templates.ts",
    "test:database-config": "ts-node scripts/test-database-config.ts",
    "test:inbox-ui": "DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fortcordis_stage ts-node scripts/test-inbox-ui-contracts.ts",
    "test:customer-service-window": "ts-node scripts/test-customer-service-window.ts",
    "test:phone-number": "ts-node scripts/test-phone-number.ts",
    "test:auth-policy": "ts-node --transpile-only scripts/test-auth-policy.ts",
    "test:webhook-cleanup-config": "DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fortcordis_stage ts-node --transpile-only scripts/test-webhook-cleanup-config.ts",
    "test:log-redaction": "ts-node --transpile-only scripts/test-log-redaction.ts",
    "test:smoke-cleanup": "ts-node --transpile-only scripts/test-smoke-cleanup.ts",
    "test:webhook-message-body": "DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fortcordis_stage ts-node --transpile-only scripts/test-webhook-message-body.ts",
    "test:message-media": "ts-node --transpile-only scripts/test-message-media.ts",
    "test:audio-transcode": "ts-node --transpile-only scripts/test-audio-transcode.ts",
    "test:conversation-ordering": "ts-node --transpile-only scripts/test-conversation-ordering.ts"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}

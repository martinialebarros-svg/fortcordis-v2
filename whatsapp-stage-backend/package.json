{
  "name": "whatsapp-stage-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Node.js + TypeScript backend for WhatsApp Cloud API on stage/local",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "smoke": "bash scripts/smoke-tests.sh",
    "test:whatsapp-retry": "ts-node scripts/test-whatsapp-retry.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}

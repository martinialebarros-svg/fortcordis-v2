PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fortcordis_stage
WHATSAPP_ACCESS_TOKEN=<your_token_here>
PHONE_NUMBER_ID=<phone_number_id_here>
WHATSAPP_VERIFY_TOKEN=<verify_token_here>
WHATSAPP_APP_SECRET=<app_secret_here>
WHATSAPP_GRAPH_API_VERSION=v26.0
# Stage-only escape hatch for a Meta-provided test number. Keep 0 in production.
WHATSAPP_ALLOW_UNVERIFIED_TEST_NUMBER=0
META_APP_ID=<meta_app_id_here>
WHATSAPP_BUSINESS_ACCOUNT_ID=<business_account_id_here>
WHATSAPP_RESERVATION_TEMPLATE_NAME=reserva_de_agendamento
WHATSAPP_RESERVATION_TEMPLATE_LANGUAGE=pt_BR
NODE_ENV=development
API_BACKEND_URL=http://127.0.0.1:8000
WHATSAPP_API_AUTH_ENABLED=false
WHATSAPP_ENFORCE_AUTH_IN_PRODUCTION=true
WHATSAPP_ALLOWED_PAPEIS=admin,recepcao,veterinario,cardiologista
WHATSAPP_WRITE_ALLOWED_PAPEIS=admin,recepcao,veterinario,cardiologista
WHATSAPP_INTERNAL_API_TOKEN=

# Optional for local debug only. Keep false in real environments.
WEBHOOK_ALLOW_UNSIGNED=false
WHATSAPP_WEBHOOK_EVENTS_CLEANUP_ENABLED=true
WHATSAPP_WEBHOOK_EVENTS_RETENTION_DAYS=30
WHATSAPP_WEBHOOK_EVENTS_CLEANUP_INTERVAL_MINUTES=60
WHATSAPP_WEBHOOK_EVENTS_CLEANUP_BATCH_SIZE=2000

# Base do backend
DATABASE_URL=sqlite:///./fortcordis.db
# Pool aplicado somente a PostgreSQL. Os limites sao por processo da API.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_PRE_PING=true
APP_ENV=development
SECRET_KEY=change-this-secret

# Papel do processo. `all` preserva desenvolvimento local; o deploy gerenciado
# define `api` para o servidor web e `worker` para a unidade systemd dedicada.
FORTCORDIS_PROCESS_ROLE=all

# WhatsApp Cloud API - reservas da Agenda
# Compartilhe o token somente entre o backend principal e o servico whatsapp-stage-backend.
WHATSAPP_AGENDA_ENABLED=false
WHATSAPP_AGENDA_SERVICE_URL=http://127.0.0.1:3010
WHATSAPP_AGENDA_INTERNAL_TOKEN=
WHATSAPP_AGENDA_TIMEOUT_SECONDS=15

# Lembrete automatico de consulta (worker em background)
# O liga/desliga real fica em Configuracoes (whatsapp_lembrete_automatico_habilitado,
# gravavel so por admin) - nao e mais uma env var. Precisa de
# WHATSAPP_AGENDA_ENABLED=true tambem, pois o envio de fato passa por ele.
WHATSAPP_REMINDER_SCHEDULER_POLL_SECONDS=300
WHATSAPP_REMINDER_SCHEDULER_DISTRIBUTED_LOCK_ENABLED=true
WHATSAPP_REMINDER_SCHEDULER_DISTRIBUTED_LOCK_KEY=80433002
WHATSAPP_REMINDER_WINDOW_HOURS=24
WHATSAPP_REMINDER_MIN_LEAD_MINUTES=45
WHATSAPP_REMINDER_MAX_ATTEMPTS=3
WHATSAPP_REMINDER_RECIPIENT_TYPE=clinica

# Chatbot de atendimento do WhatsApp (Fase 1 - so schema/config, sem
# comportamento novo em runtime ainda). O liga/desliga real precisa dos DOIS
# interrupores: WHATSAPP_BOT_ENABLED aqui E configuracoes.whatsapp_bot_atendimento_habilitado
# (banco, gravavel so por admin) - de proposito, para nao repetir a licao do
# lembrete automatico (nasceu so com env var e teve que migrar depois).
WHATSAPP_BOT_ENABLED=false
WHATSAPP_BOT_MODEL=gpt-5.6-sol
WHATSAPP_BOT_PROMPT_VERSION=whatsapp-bot-v1
WHATSAPP_BOT_DEBOUNCE_SECONDS=12
WHATSAPP_BOT_SCHEDULER_POLL_SECONDS=5
WHATSAPP_BOT_SCHEDULER_DISTRIBUTED_LOCK_ENABLED=true
WHATSAPP_BOT_SCHEDULER_DISTRIBUTED_LOCK_KEY=80433003
WHATSAPP_BOT_MAX_ATTEMPTS=3
WHATSAPP_BOT_HANDOFF_PAUSE_HOURS=12
# Pausa apos envio assistido de rascunho (separada da de handoff).
WHATSAPP_BOT_ASSISTED_SEND_PAUSE_HOURS=2
# Memoria de conversa: mensagens anteriores no prompt (0 desliga).
WHATSAPP_BOT_HISTORICO_MENSAGENS=8
WHATSAPP_BOT_MAX_REPLIES_PER_CONVERSATION_DAY=20
WHATSAPP_BOT_MAX_TOKENS_PER_DAY=100000
WHATSAPP_BOT_MAX_REPLY_CHARS=900
# Fase 6: custo por milhao de tokens. 0.0 = nao configurado (painel
# reporta tokens e nao finge custo zero).
WHATSAPP_BOT_INPUT_COST_PER_MILLION=0.0
WHATSAPP_BOT_OUTPUT_COST_PER_MILLION=0.0
WHATSAPP_BOT_RECONCILE_EVERY_CYCLES=60
WHATSAPP_BOT_RECONCILE_WINDOW_MINUTES=30

# Formalizacao de agendamento via Portal Clinicas (link publico com token)
# PUBLIC_APP_BASE_URL precisa ser a origem publica do frontend (ex.: https://app.fortcordis.com),
# usada para montar o link enviado a clinica - nao usar request.base_url aqui porque
# quem gera o link e o whatsapp-stage-backend chamando esta API diretamente, sem passar
# pelo proxy publico.
PUBLIC_APP_BASE_URL=http://localhost:3000
AGENDA_FORMALIZACAO_INVITE_DEFAULT_HOURS=72

# Assistente de Laudo por Voz para Ecocardiografia
# Desativado por padrão. Habilite primeiro em desenvolvimento/homologação.
AI_ECHO_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
AI_STRUCTURING_MODEL=gpt-5.6-sol
AI_AUDIO_RETENTION_HOURS=2
AI_ECHO_AUDIO_MAX_BYTES=20971520
AI_ECHO_AUDIO_MAX_SECONDS=600
AI_ECHO_MAX_ATTEMPTS=3
AI_ECHO_MONTHLY_SESSION_LIMIT=100
AI_ECHO_PROVIDER_TIMEOUT_SECONDS=90
AI_ECHO_REASONING_EFFORT=low
AI_ECHO_MAX_OUTPUT_TOKENS=8000
AI_ECHO_CLEANUP_INTERVAL_MINUTES=15

# Preencha somente se a estimativa interna de custo por sessão for desejada.
AI_ECHO_STRUCTURING_INPUT_COST_PER_MILLION=0
AI_ECHO_STRUCTURING_OUTPUT_COST_PER_MILLION=0

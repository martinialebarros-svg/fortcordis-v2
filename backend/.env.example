# Base do backend
DATABASE_URL=sqlite:///./fortcordis.db
APP_ENV=development
SECRET_KEY=change-this-secret

# WhatsApp Cloud API - reservas da Agenda
# Compartilhe o token somente entre o backend principal e o servico whatsapp-stage-backend.
WHATSAPP_AGENDA_ENABLED=false
WHATSAPP_AGENDA_SERVICE_URL=http://127.0.0.1:3010
WHATSAPP_AGENDA_INTERNAL_TOKEN=
WHATSAPP_AGENDA_TIMEOUT_SECONDS=15

# Assistente de Laudo por Voz para Ecocardiografia
# Desativado por padrão. Habilite primeiro em desenvolvimento/homologação.
AI_ECHO_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
AI_STRUCTURING_MODEL=gpt-5.6-sol
AI_AUDIO_RETENTION_HOURS=2
AI_ECHO_AUDIO_MAX_BYTES=20971520
AI_ECHO_AUDIO_MAX_SECONDS=600
AI_ECHO_MAX_ATTEMPTS=3
AI_ECHO_MONTHLY_SESSION_LIMIT=100
AI_ECHO_PROVIDER_TIMEOUT_SECONDS=90
AI_ECHO_REASONING_EFFORT=low
AI_ECHO_MAX_OUTPUT_TOKENS=8000
AI_ECHO_CLEANUP_INTERVAL_MINUTES=15

# Preencha somente se a estimativa interna de custo por sessão for desejada.
AI_ECHO_STRUCTURING_INPUT_COST_PER_MILLION=0
AI_ECHO_STRUCTURING_OUTPUT_COST_PER_MILLION=0

# Upstream interno; o middleware verifica a sessao na API antes de renderizar.
API_BACKEND_URL=http://127.0.0.1:8000
# Manter os mesmos nomes configurados no backend.
AUTH_COOKIE_NAME=fortcordis_session
SUPABASE_REFRESH_COOKIE_NAME=fortcordis_refresh
CSRF_COOKIE_NAME=fortcordis_csrf
CSRF_HEADER_NAME=x-csrf-token
# A integracao Supabase roda no backend; nao ha segredo administrativo no cliente.
